# ============================================================
# AutoLaunch 环境变量配置
# 纯 Vite 静态前端配置。修改后重新执行 npm run build。
# ============================================================

# 网站标题（浏览器标签页 & ICP 备案用，必须包含中文，禁止纯英文/纯域名）
# 推荐格式：AutoLaunch 汽车数字发布会展示站 · SU7 Ultra 概念演示
VITE_APP_SITE_TITLE=AutoLaunch 汽车数字发布会展示站 · SU7 Ultra 概念演示

# 页面左下角永久显示的非官方声明
VITE_APP_UNOFFICIAL_DISCLAIMER=非官方概念演示 | 模型：Ddiaz Design（Sketchfab CC BY-NC-SA 4.0）| 不代表小米官方

# Web Speech API 预留语言设置
VITE_VOICE_LANG=zh-CN

# Product Pack 当前实际加载的模型路径
VITE_MODEL_PATH=/assets/su7_ultra.glb

# 车窗交互：当 GLB 缺少对应节点时是否启用虚拟玻璃 Mesh（1 = 启用，0 = 仅镜头降级）
VITE_WINDOW_VIRTUAL_MESH_FALLBACK=1

# 车窗全部按钮默认开/关百分比（整数 0-100）
VITE_WINDOW_FULL_OPEN_PROGRESS=100
VITE_WINDOW_FULL_CLOSE_PROGRESS=0

# 新开合部件：缺少真实节点时的提示，以及前备箱/车门默认开启角度（度）
VITE_PARTS_VIRTUAL_HINT=⚠ 当前演示模型部分开合节点暂未映射，已使用虚拟占位演示；v0.3 后续迭代将接入真实部件 Mesh。
VITE_PARTS_DEFAULT_OPEN_ANGLE_FRUNK=55
VITE_PARTS_DEFAULT_OPEN_ANGLE_DOOR=63
