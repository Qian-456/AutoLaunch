# 页面左下角永久显示的非官方声明
VITE_APP_UNOFFICIAL_DISCLAIMER=非官方概念演示 | 模型：Ddiaz Design（Sketchfab CC BY-NC-SA 4.0）| 不代表小米官方

# Web Speech API 预留语言设置
VITE_VOICE_LANG=zh-CN

# Product Pack 当前实际加载的模型
VITE_MODEL_PATH=/assets/su7_ultra.glb

# 车窗交互：当 GLB 缺少对应节点时是否启用虚拟玻璃 Mesh（1 = 启用，0 = 仅镜头降级）
VITE_WINDOW_VIRTUAL_MESH_FALLBACK=1

# 车窗全部按钮默认开/关百分比（整数 0-100）
VITE_WINDOW_FULL_OPEN_PROGRESS=100
VITE_WINDOW_FULL_CLOSE_PROGRESS=0

# FastAPI 一键部署
AUTOLAUNCH_BIND=0.0.0.0
AUTOLAUNCH_PORT=8000
AUTOLAUNCH_DIST_DIR=dist
