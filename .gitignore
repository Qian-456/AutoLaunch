# AutoLaunch public repository ignore rules

# Dependencies and local tool environments
node_modules/
.venv/
.pnp/
.pnp.js
.yarn/install-state.gz
__pycache__/
*.py[cod]

# Build and test output
dist/
dist-ssr/
build/
out/
coverage/
*.lcov
.nyc_output/
playwright-report/
test-results/
*.tsbuildinfo
.vite/

# Secrets and local environment
.env
.env.local
.env.*.local
*.local
# Keep the public configuration template.
!.env.example

# Logs and editor files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.vscode/*
!.vscode/extensions.json
!.vscode/README.md
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Private development playbooks and agent tooling
AGENTS.md
.trae/
.agents/
.codex/
skills/
scripts/

# Internal plans, design references, production media, and visual QA
docs/
screenshots/
visual-tests/
videos/
recordings/
.tts-cache/
*.wav
*.mp3
*.aac
*.m4a
*.flac
*.ogg
*.opus
*.srt
*.ass
*.vtt
*.mkv
*.mp4
*.mov

# Local 3D source/master files and generated inspection data
*.glb
*.gltf
*.fbx
*.obj
*.stl
*.bin
*.hdr
glb-nodes.json
2025-xiaomi-su7-ultra/
.tmp/

# Runtime 3D assets intentionally published with the application
!public/assets/*.glb
!public/assets/*.gltf

# Archives and operating-system files
*.zip
*.tar.gz
*.tmp
*.temp
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
